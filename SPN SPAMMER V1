-- Chat functions
local function getChannel()
	local channels = TextChatService:FindFirstChild("TextChannels")
	if channels then
		return channels:FindFirstChild("RBXGeneral")
	end
	return nil
end

local function buildMessage(targetName)
	local output = {}

	-- 1. Rotating Long Head Prefix
	table.insert(output, prefixes[prefixIndex])

	-- 2. Target Name Prefix if available
	if targetName ~= "" then
		table.insert(output, "[" .. targetName .. "]")
	end

	-- 3. Rotating Word
	table.insert(output, words[wordIndex])

	-- 4. Random Emoji
	local randomEmoji = emojis[math.random(1, #emojis)]
	table.insert(output, randomEmoji)

	-- Update indices for next message loop
	prefixIndex = prefixIndex + 1
	if prefixIndex > #prefixes then
		prefixIndex = 1
	end

	wordIndex = wordIndex + 1
	if wordIndex > #words then
		wordIndex = 1
	end

	return table.concat(output, " ")
end

local function sendMessage(text)
	local channel = getChannel()
	if channel then
		pcall(function()
			channel:SendAsync(text)
		end)
	else
		pcall(function()
			local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			if events and events:FindFirstChild("SayMessageRequest") then
				events.SayMessageRequest:FireServer(text, "All")
			end
		end)
	end
end

-- Start / Stop
startButton.MouseButton1Click:Connect(function()
	if running then return end

	local targetName = nameBox.Text
	local customDelay = tonumber(delayBox.Text) or 0.25
	if customDelay < 0.05 then customDelay = 0.25 end

	running = true
	status.Text = "Status: RUNNING" .. (targetName ~= "" and " (Target: " .. targetName .. ")" or "")
	status.TextColor3 = Color3.fromRGB(255, 80, 80)

	task.spawn(function()
		while running do
			local message = buildMessage(targetName)
			sendMessage(message)
			task.wait(customDelay)
		end
	end)
end)

stopButton.MouseButton1Click:Connect(function()
	running = false
	local targetName = nameBox.Text
	status.Text = "Status: STOPPED (Target: " .. (targetName ~= "" and targetName or "NONE") .. ")"
